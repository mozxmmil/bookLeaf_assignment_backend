// BookLeaf Author Support Portal — database schema
// Prisma 7: client is generated into src/generated/prisma and talks to Postgres via @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // ESM + ".js" import suffixes so the generated TS compiles cleanly under NodeNext
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Category {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum AiStatus {
  PENDING
  DONE
  FAILED
}

model User {
  id           String         @id
  email        String         @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  author       Author?
  assigned     Ticket[]       @relation("Assignee")
  messages     Message[]
  notes        InternalNote[]
}

model Author {
  id         String    @id // keeps the id from the dataset (e.g. AUT001)
  userId     String    @unique
  phone      String?
  city       String?
  country    String?
  joinedDate DateTime? @db.Date
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  books      Book[]
  tickets    Ticket[]
}

model Book {
  id              String    @id
  authorId        String
  title           String
  isbn            String? // null while the book is still in production
  genre           String?
  publicationDate DateTime? @db.Date
  status          String
  mrp             Decimal   @default(0) @db.Decimal(10, 2)
  copiesSold      Int       @default(0)
  royaltyEarned   Decimal   @default(0) @db.Decimal(12, 2)
  royaltyPaid     Decimal   @default(0) @db.Decimal(12, 2)
  // royaltyPending is derived (earned - paid) so it can never drift out of sync
  author          Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tickets         Ticket[]

  @@index([authorId])
}

model Ticket {
  id                 Int            @id @default(autoincrement())
  authorId           String
  bookId             String? // null = General / Account level
  subject            String
  description        String
  attachmentName     String?
  status             TicketStatus   @default(OPEN)
  // Effective values (AI value or admin override)
  category           Category?
  priority           Priority?
  // Original AI output — kept separately to measure override rate / accuracy
  aiCategory         Category?
  aiPriority         Priority?
  aiReason           String?
  aiStatus           AiStatus       @default(PENDING)
  aiSource           String? // 'llm' | 'rules'
  categoryOverridden Boolean        @default(false)
  priorityOverridden Boolean        @default(false)
  aiDraft            String? // cached draft; cleared when new messages arrive
  assigneeId         String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  resolvedAt         DateTime?      @db.Timestamptz(3)
  author             Author         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book               Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  assignee           User?          @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages           Message[]
  notes              InternalNote[]

  @@index([status, priority, createdAt])
  @@index([authorId])
}

model Message {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  senderId     String
  senderRole   Role
  body         String
  isAiAssisted Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User     @relation(fields: [senderId], references: [id])

  @@index([ticketId])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  adminId   String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin     User     @relation(fields: [adminId], references: [id])

  @@index([ticketId])
}
