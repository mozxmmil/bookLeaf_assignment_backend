# Template for the VPS .env used by docker-compose.prod.yml. On the VPS: cp .env.prod.example .env
# Never commit .env (it is in .gitignore and .dockerignore, so it never goes to GitHub or into the image).
# No DATABASE_URL needed: Compose builds it from POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB.

# Your Vercel URL, exact, no trailing slash (comma-separated for more than one)
CLIENT_ORIGIN=https://your-app.vercel.app

# Postgres in Docker. The container creates this user and database on its first start.
# Use letters, digits and _ only. To change them after the first start you must delete the volume (dc down -v).
POSTGRES_USER=bookleaf
POSTGRES_DB=bookleaf
# Generate with: openssl rand -hex 32   (hex only, so it is safe inside the DB URL)
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters: openssl rand -hex 32
JWT_SECRET=

# Google AI Studio key. Leave empty to run without AI (keyword rules + manual replies).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Port on 127.0.0.1 where Nginx reaches the API. Check it is free first: sudo ss -tlnp | grep ':4815 '
# If you change it, change both proxy_pass lines in nginx/bookleaf-api.conf to match.
API_PORT=4815
