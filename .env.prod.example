# Values for docker-compose.prod.yml. On the VPS: cp .env.prod.example .env.prod
# Never commit .env.prod.

# Your Vercel URL, exact, no trailing slash (comma-separated for more than one)
CLIENT_ORIGIN=https://your-app.vercel.app

# Generate each with: openssl rand -hex 32   (hex only, so it is safe inside the DB URL)
POSTGRES_PASSWORD=
JWT_SECRET=

# Google AI Studio key. Leave empty to run without AI (keyword rules + manual replies).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Port on 127.0.0.1 where Nginx reaches the API. Check it is free first: sudo ss -tlnp | grep ':4815 '
# If you change it, change both proxy_pass lines in nginx/bookleaf-api.conf to match.
API_PORT=4815
