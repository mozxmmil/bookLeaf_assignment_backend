# Host port for the dev Postgres in docker-compose.yml (keep DATABASE_URL below in sync)
POSTGRES_PORT=5440

# Postgres connection string (Neon / Supabase / local)
DATABASE_URL=postgresql://postgres:bookleaf@localhost:5440/bookleaf
# Long random string (openssl rand -hex 32)
JWT_SECRET=
# Google AI Studio key – server only, never exposed to the client
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is rate-limited, overloaded or out of its (per-model) free quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Frontend origin allowed by CORS (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:3000
PORT=4000
